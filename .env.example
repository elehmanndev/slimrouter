# Password for the dashboard. Leave empty to disable login (only do that on a trusted LAN).
DASHBOARD_PASSWORD=change-me
# Optional. Secret used to sign dashboard sessions. Generated into the data dir when unset.
# SESSION_SECRET=
# Google OAuth client secrets for Antigravity and Gemini CLI. The defaults are the public ones from the official apps.
# ANTIGRAVITY_OAUTH_SECRET=
# GEMINI_CLI_OAUTH_SECRET=
# Where the SQLite database and secrets live. Docker sets this to /data.
# DATA_DIR=./data
TZ=UTC
